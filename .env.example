APP_NAME="Bansa Open 2026"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://domainanda.com

# Database Connection (Sesuaikan dengan Database di cPanel / Shared Hosting)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_bansaopen
DB_USER=cpaneluser_dbuser
DB_PASS=PasswordDatabaseKuat123!

# Akun admin awal (dipakai saat menjalankan seeder Phinx pertama kali)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiDenganPasswordAman123!

# Tailwind Mode:
# 'build' : Menggunakan file terkompilasi public/assets/app.css (Sangat direkomendasikan di production, cepat & ringan)
# 'cdn'   : Menggunakan Tailwind Play CDN langsung dari browser (opsi jika tanpa build lokal)
TAILWIND_MODE=build

# URL login admin (Path URL rahasia, hindari standar /admin)
ADMIN_LOGIN_PATH=admin-bansa-login
